From 6703f1a906b01e5f67847d16605fd2bed13bff22 Mon Sep 17 00:00:00 2001
From: ravigohel142996 <ravigohel142996@users.noreply.github.com>
Date: Sat, 19 Sep 2026 16:51:18 +0000
Subject: [PATCH] fix(responses): normalize string input to canonical list
 before provider dispatch

OpenAI's Responses API documents input as accepting either a string or an
array. Provider transforms that only accept the array form (e.g. the chatgpt
deployment in #41963) turn a spec-compliant string request into a 400 that
looks like a client bug.

Add _normalize_responses_api_string_input() and call it once, centrally, in
responses() right before dispatch so every lane - MCP gateway, emulated file
search, chat-completions bridge, and native providers - sees the canonical
array shape. List input passes through untouched.

Closes #41963

Co-authored-by: arena-agent <agent@arena.ai>
---
 litellm/responses/main.py                     | 25 +++++++
 .../test_string_input_normalization.py        | 72 +++++++++++++++++++
 2 files changed, 97 insertions(+)
 create mode 100644 tests/test_litellm/responses/test_string_input_normalization.py

diff --git a/litellm/responses/main.py b/litellm/responses/main.py
index 5a4a08b..b97bcf0 100644
--- a/litellm/responses/main.py
+++ b/litellm/responses/main.py
@@ -569,6 +569,21 @@ def _prompt_management_sees_a_provisional_message_list(
         kwargs.pop(CARRY_UNMATCHED_MESSAGE_POINTS, None)
 
 
+def _normalize_responses_api_string_input(input: str | ResponseInputParam) -> ResponseInputParam:
+    """Normalize a plain-string ``input`` to the canonical list form.
+
+    OpenAI's Responses API documents ``input`` as accepting *either* a string or
+    an array. Provider transforms that only handle the array form turn a
+    spec-compliant string request into a 400 that looks like a client bug
+    (see #41963). Normalize once, centrally, before dispatch, so every
+    Responses-capable provider sees one canonical shape; list input passes
+    through untouched.
+    """
+    if isinstance(input, str):
+        return cast(ResponseInputParam, [{"role": "user", "content": input}])
+    return input
+
+
 @client
 async def aresponses(
     input: str | ResponseInputParam,
@@ -1232,6 +1247,16 @@ def responses(
         #########################################################
         input, tools = _apply_managed_file_id_mapping(input=input, tools=tools, kwargs=kwargs, local_vars=local_vars)
 
+        #########################################################
+        # Normalize a plain-string input to the canonical list form once
+        # (OpenAI's Responses API accepts either shape), so every downstream
+        # dispatch - MCP gateway, file search, chat-completions bridge, and
+        # native providers - sees the array shape their transforms expect
+        # (see #41963).
+        #########################################################
+        input = _normalize_responses_api_string_input(input)
+        local_vars["input"] = input
+
         #########################################################
         # Native MCP Responses API
         #########################################################
diff --git a/tests/test_litellm/responses/test_string_input_normalization.py b/tests/test_litellm/responses/test_string_input_normalization.py
new file mode 100644
index 0000000..641c9f0
--- /dev/null
+++ b/tests/test_litellm/responses/test_string_input_normalization.py
@@ -0,0 +1,72 @@
+"""Regression tests for https://github.com/BerriAI/litellm/issues/41963.
+
+OpenAI's Responses API documents ``input`` as accepting either a string or an
+array. A plain string must be normalized centrally, before provider dispatch,
+so provider transforms that only accept the array form stop rejecting
+spec-compliant requests.
+"""
+
+from unittest.mock import MagicMock, patch
+
+from litellm.responses.main import _normalize_responses_api_string_input, responses
+
+
+class TestNormalizeResponsesApiStringInput:
+    def test_string_input_becomes_canonical_list(self):
+        assert _normalize_responses_api_string_input("Reply with exactly ROUTE_OK.") == [
+            {"role": "user", "content": "Reply with exactly ROUTE_OK."}
+        ]
+
+    def test_list_input_passes_through_untouched(self):
+        original = [{"role": "user", "content": "Reply with exactly ROUTE_OK."}]
+        assert _normalize_responses_api_string_input(original) is original
+
+    def test_empty_string_is_normalized(self):
+        assert _normalize_responses_api_string_input("") == [{"role": "user", "content": ""}]
+
+    def test_non_ascii_content_preserved(self):
+        assert _normalize_responses_api_string_input("caf\u00e9") == [{"role": "user", "content": "caf\u00e9"}]
+
+
+class TestResponsesCentralDispatchNormalizesInput:
+    def test_native_provider_receives_list_input(self):
+        """responses() must hand the native provider handler a normalized list."""
+
+        captured: dict = {}
+
+        def capture_handler(**kwargs):
+            captured.update(kwargs)
+
+        with patch("litellm.responses.main.base_llm_http_handler") as mock_handler:
+            mock_handler.response_api_handler.side_effect = capture_handler
+            responses(
+                input="Reply with exactly ROUTE_OK.",
+                model="gpt-4o",
+                litellm_logging_obj=MagicMock(),
+                api_key="sk-test",
+            )
+
+        assert captured["input"] == [{"role": "user", "content": "Reply with exactly ROUTE_OK."}]
+
+    def test_native_provider_list_input_unchanged(self):
+        """List input must reach the native provider handler with content intact
+        (the pipeline may legitimately rebuild the container while restoring
+        encrypted-content item IDs, so assert on equality + shape)."""
+
+        original = [{"role": "user", "content": "Reply with exactly ROUTE_OK."}]
+        captured: dict = {}
+
+        def capture_handler(**kwargs):
+            captured.update(kwargs)
+
+        with patch("litellm.responses.main.base_llm_http_handler") as mock_handler:
+            mock_handler.response_api_handler.side_effect = capture_handler
+            responses(
+                input=original,
+                model="gpt-4o",
+                litellm_logging_obj=MagicMock(),
+                api_key="sk-test",
+            )
+
+        assert isinstance(captured["input"], list)
+        assert captured["input"] == original
